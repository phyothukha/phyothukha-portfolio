---
import { Image } from "astro:assets";
import timelimebg from "@/assets/timelimebg.svg";
import timelimebgwt from "@/assets/timelimebg-wt.svg";
import about from "@/assets/bb.jpg";
---

<section
  id="education"
  class="dark:bg-[#292f36] bg-[#eeeeee] bg-opacity-90 py-20 relative overflow-hidden"
>
  <div class="absolute top-0 z-10 dark:inline-block hidden">
    <img
      src={timelimebg.src}
      alt="timeline background"
      loading="lazy"
      class="max-w-none object-cover object-center w-[2000px] h-auto"
    />
  </div>
  <div class="absolute top-0 z-10 dark:hidden inline-block">
    <img
      src={timelimebgwt.src}
      alt="timeline white background"
      loading="lazy"
      class="max-w-none object-cover object-center w-[2000px] h-auto"
    />
  </div>
  <div class="container mx-auto max-w-6xl relative z-30 lg:px-0 px-10">
    <h1 id="education-title" class="text-4xl font-bold">Education</h1>
    <div class="lg:px-28 mt-20">
      <div
        class="flex flex-wrap md:flex-row flex-col-reverse md:flex-nowrap md:justify-start justify-center items-center gap-20"
      >
        <aside class="lg:w-2/3">
          <button
            class="mb-10 bg-darkary lg:text-2xl text-xl w-56 font-medium text-primary dark:text-secondary border-b-2 dark:border-secondary border-wtsecondary rounded-none border-l-2 border-r-2 border-t-2 rounded-tl-[2.3rem] lg:p-5 p-3 rounded-br-[2rem]"
          >
            About Me
          </button>
          <div
            id="education-text"
            class="bg-darkary border-2 border-wtsecondary dark:border-secondary py-[30px] px-[50px] rounded-3xl shadow-5xl dark:shadow-3xl cursor-pointer transition duration-500 ease-in-out"
          >
            <h2
              class="font-Ubuntu selection:text-primary dark:selection:text-darkary text-2xl mb-5 text-secondary"
            >
              Hello!
            </h2>
            <p
              class="text-primary font-normal text-sm lg:text-base leading-relaxed mb-4 dark:selection:text-darkary"
            >
              My name is <span class="text-secondary">Phyo Thu Kha</span> and I
              specialize in web development that utilizes HTML, CSS, JS, and
              <span class="text-secondary">REACT</span> etc.
            </p>
            <p
              class="text-primary font-normal text-sm lg:text-base leading-relaxed mb-4 dark:selection:text-darkary"
            >
              I am a highly motivated individual and eternal optimist
              dedicated to writing clear, concise, robust code that works.
              Striving to never stop learning and improving.
            </p>
            <p
              class="text-primary font-normal text-sm lg:text-base leading-relaxed mb-4 dark:selection:text-darkary"
            >
              When I'm not coding, I am writing blogs, reading, or picking up
              some new hands-on art project like photography.
            </p>
            <p
              class="text-primary font-normal text-sm lg:text-base leading-relaxed mb-4 dark:selection:text-darkary"
            >
              I like to have my perspective and belief systems challenged so
              that I see the world through new eyes.
            </p>
          </div>
        </aside>
        <aside class="lg:w-1/3 md:self-end">
          <div
            id="education-image"
            class="overflow-hidden h-[400px] w-full bg-primary border-2 border-wtsecondary dark:border-secondary rounded-xl cursor-pointer transition duration-500 ease-in-out"
          >
            <Image
              src={about}
              alt="about me"
              width={800}
              quality={90}
              class="w-full h-full object-cover object-top"
            />
          </div>
        </aside>
      </div>
    </div>
  </div>
</section>

<script>
  import gsap from "gsap";
  import ScrollTrigger from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const section = document.getElementById("education");
  const text = document.getElementById("education-text");
  const title = document.getElementById("education-title");
  const image = document.getElementById("education-image");

  gsap.fromTo(
    text,
    { x: -200, opacity: 0.5 },
    {
      opacity: 1,
      x: 0,
      duration: 0.3,
      ease: "back.in",
      scrollTrigger: {
        trigger: section,
        start: "top center",
      },
    },
  );

  gsap.fromTo(
    title,
    { y: -100 },
    {
      y: 0,
      duration: 0.5,
      ease: "back.out",
      scrollTrigger: {
        trigger: section,
        start: "top center",
      },
    },
  );

  gsap.fromTo(
    image,
    { opacity: 0, x: 100 },
    {
      x: 1,
      opacity: 1,
      duration: 0.5,
      ease: "back.in",
      scrollTrigger: {
        trigger: section,
        start: "top center",
      },
    },
  );
</script>
